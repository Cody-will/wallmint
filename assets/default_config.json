{
  "paths": {
    "wallpaper_dir": "~/Pictures/walls",
    "config_dir": "~/.config/wallmint",
    "style_path": "~/.config/wallmint/style.css",
    "config_path": "~/.config/wallmint/config.json",
    "wallust_colors_json": "~/.cache/wallust/colors.json"
  },
  "ui": {
    "title": "Wallmint",
    "window": {
      "width": 1100,
      "height": 720,
      "resizable": true
    },
    "preview": {
      "aspect_ratio": "16:9",
      "content_fit": "cover",
      "vexpand": true,
      "hexpand": true
    }
  },
  "hyprpaper": {
    "enabled": true,
    "hyprctl_bin": "hyprctl",
    "monitor": "*",
    "preload": true
  },
  "wallust": {
    "enabled": true,
    "bin": "wallust"
  }
}
